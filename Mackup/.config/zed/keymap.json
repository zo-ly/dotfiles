[
  {
    "context": "Editor && vim_mode == normal && !menu",
    "bindings": {
      "shift-j": "pane::ActivatePreviousItem",
      "shift-k": "pane::ActivateNextItem"
    }
  },
  {
    // Overrides cmd-shift-g's default search::SelectPreviousMatch (Pane) and
    // agent::SelectPreviousThreadMatch (AcpThread); deeper contexts win, so all three are needed.
    "context": "Workspace || Pane || AcpThread",
    "bindings": {
      "cmd-shift-g": "git_panel::ToggleFocus"
    }
  },
  {
    "context": "VimControl && !menu",
    "bindings": {
      "g m": ["vim::MiddleOfLine", { "display_lines": true }]
    }
  }
]
